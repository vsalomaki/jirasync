# Settings for the local Jira. Copy to docker/.env and edit; docker/.env is
# gitignored. Everything here is read by:
#
#   docker compose --env-file docker/.env -f docker/compose.yml up -d
#
# The licence and the administrator account are NOT here, because the image
# has no way to accept them. See README.md.

JIRA_PORT=8180
JIRA_IMAGE_TAG=9.12

POSTGRES_DB=jira
POSTGRES_USER=jira
POSTGRES_PASSWORD=jira

JVM_MINIMUM_MEMORY=1024m
JVM_MAXIMUM_MEMORY=2048m

# Anything the image does not expose directly can still be written into
# jira-config.properties, one property per numbered variable:
#
# ADDITIONAL_JIRA_CONFIG_01=jira.websudo.is.disabled=true
# ADDITIONAL_JIRA_CONFIG_02=jira.dashboard.max.gadgets=50
#
# A __EXPAND_ENV suffix substitutes {VAR} from the environment, which keeps a
# secret out of this file:
#
# ADDITIONAL_JIRA_CONFIG_03__EXPAND_ENV=some.password={SOME_SECRET}
