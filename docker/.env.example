# Settings for the local Jira. Copy this file to docker/.env and edit; that path
# is gitignored. Run compose from the repository root:
#
#   docker compose --env-file docker/.env -f docker/compose.yml up -d
#
# The licence and the administrator account are NOT here, because the image has
# no variable for either. See README.md.
#
# These names are the image's own. The full reference lists many more:
# https://atlassian.github.io/data-center-helm-charts/containers/JIRA/

# ----------------------------------------------------------------- compose ---
JIRA_PORT=8180
JIRA_IMAGE_TAG=9.12

POSTGRES_DB=jira
POSTGRES_USER=jira
POSTGRES_PASSWORD=jira

# --------------------------------------------------------------------- jvm ---
# The image defaults to 384m/768m. Jira starts on that and indexes badly.
JVM_MINIMUM_MEMORY=1024m
JVM_MAXIMUM_MEMORY=2048m
# JVM_RESERVED_CODE_CACHE_SIZE=512m
# JVM_SUPPORT_RECOMMENDED_ARGS=

# ------------------------------------------------------------------- proxy ---
# Only needed when the instance is reached through something other than the
# published port. Jira builds its own base URL from these.
# ATL_PROXY_NAME=jira.example.invalid
# ATL_PROXY_PORT=443
# ATL_TOMCAT_SCHEME=https
# ATL_TOMCAT_SECURE=true
# ATL_TOMCAT_CONTEXTPATH=/jira

# --------------------------------------------------------------- debugging ---
# VERBOSE_LOGS=true
# ATL_FORCE_CFG_UPDATE=true          # regenerate config files on next restart
# ATL_JIRA_SESSION_TIMEOUT=30

# ---------------------------------------------------- arbitrary properties ---
# Anything without a dedicated variable can still reach jira-config.properties,
# one complete property line per numbered variable:
#
# ADDITIONAL_JIRA_CONFIG_01=jira.websudo.is.disabled=true
# ADDITIONAL_JIRA_CONFIG_02=jira.dashboard.max.gadgets=50
#
# A __EXPAND_ENV suffix substitutes {VAR} from the environment, which keeps a
# secret out of this file:
#
# ADDITIONAL_JIRA_CONFIG_03__EXPAND_ENV=some.password={SOME_SECRET}
